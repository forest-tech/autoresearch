+    elif args.command == "write-run-config":
+        _write_json(
+            args.output,
+            make_run_config(
+                args.template,
+                args.history_mode,
+                args.history_limit,
+                args.primary_metric,
+                args.direction,
+                args.repo_root,
+            ),
