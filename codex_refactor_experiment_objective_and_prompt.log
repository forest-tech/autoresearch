     total_nats = 0.0
     total_bytes = 0
+    total_loss_nats = 0.0
+    total_tokens = 0
     for _ in range(steps):
         x, y, _ = next(val_loader)
         loss_flat = model(x, y, reduction='none').view(-1)
@@ -362,7 +370,18 @@
