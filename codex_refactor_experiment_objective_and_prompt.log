+class ObjectiveTests(unittest.TestCase):
+    def test_defaults_preserve_bpb_minimization(self):
+        self.assertEqual(eu.DEFAULT_PRIMARY_METRIC, "val_bpb")
+        self.assertEqual(eu.DEFAULT_OBJECTIVE_DIRECTION, "min")
