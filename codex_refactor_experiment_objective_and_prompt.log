+def infer_direction(records, metric, explicit=None):
+    if explicit:
+        return explicit
+    directions = {
+        record.get("objective_direction")
+        for record in records
+        if record.get("primary_metric") == metric
+        and record.get("objective_direction") in {"min", "max"}
+    }
