cleanup_worktrees() {
    local wt
    for wt in "${ACTIVE_WORKTREES[@]:-}"; do
        if [[ -n "${wt}" && -e "${wt}/.git" ]]; then
            git worktree remove --force "${wt}" >/dev/null 2>&1 || true
        fi
    done
    git worktree prune >/dev/null 2>&1 || true
}

trap cleanup_worktrees EXIT

register_worktree() {
    ACTIVE_WORKTREES+=("$1")
}

remove_worktree() {
    local wt="$1"
    git worktree remove --force "${wt}" >/dev/null
}

create_worktree() {
    local wt="$1"
    local commit="$2"

